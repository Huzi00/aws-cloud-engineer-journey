{
    "Version": "2012-10-17",
    "Statement": [
    {
      "Sid": "AllowS3ReadOnlyAccess",
      "Effect": "Allow",
      "Action": [
        "s3:Get*",
        "s3:List*"
      ],
      "Resource": [
        "arn:aws:s3:::cloud-journey-logs-bucket",
        "arn:aws:s3:::cloud-journey-logs-bucket/*"
      ]
    },
    {
      "Sid": "DenyS3DeleteOperations",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteBucket",
        "s3:DeleteObject"
      ],
      "Resource": "*"
    }
  ]
}
