{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Description": "Auto Scaling Group with Launch Template integrated into ALB Target Group",
    "Parameters": {
      "VpcId": {
        "Type": "AWS::EC2::VPC::Id",
        "Description": "Target VPC ID."
      },
      "SubnetOne": {
        "Type": "AWS::EC2::Subnet::Id",
        "Description": "First public subnet for ASG."
      },
      "SubnetTwo": {
        "Type": "AWS::EC2::Subnet::Id",
        "Description": "Second public subnet for ASG."
      },
      "TargetGroupArn": {
        "Type": "String",
        "Description": "ARN of the ALB Target Group from Day 26."
      },
      "ImageId": {
        "Type": "String",
        "Description": "AMI ID for EC2 instances (e.g., Amazon Linux 2023)."
      }
    },
    "Resources": {
      "WebLaunchTemplate": {
        "Type": "AWS::EC2::LaunchTemplate",
        "Properties": {
          "LaunchTemplateName": "cloud-engineer-web-template",
          "LaunchTemplateData": {
            "ImageId": { "Ref": "ImageId" },
            "InstanceType": "t3.micro",
            "UserData": {
              "Fn::Base64": "#!/bin/bash\nyum update -y\nyum install -y httpd\necho '<h1>Hello from Auto-Scaled EC2!</h1>' > /var/www/html/index.html\nsystemctl start httpd\nsystemctl enable httpd"
            }
          }
        }
      },
      "WebServerASG": {
        "Type": "AWS::AutoScaling::AutoScalingGroup",
        "Properties": {
          "AutoScalingGroupName": "cloud-engineer-web-asg",
          "VPCZoneIdentifier": [
            { "Ref": "SubnetOne" },
            { "Ref": "SubnetTwo" }
          ],
          "LaunchTemplate": {
            "LaunchTemplateId": { "Ref": "WebLaunchTemplate" },
            "Version": { "Fn::GetAtt": ["WebLaunchTemplate", "LatestVersionNumber"] }
          },
          "MinSize": "1",
          "MaxSize": "3",
          "DesiredCapacity": "2",
          "TargetGroupARNs": [
            { "Ref": "TargetGroupArn" }
          ],
          "HealthCheckType": "ELB",
          "HealthCheckGracePeriod": 300
        }
      }
    },
    "Outputs": {
      "AutoScalingGroupName": {
        "Description": "Name of the created Auto Scaling Group",
        "Value": { "Ref": "WebServerASG" }
      }
    }
  }