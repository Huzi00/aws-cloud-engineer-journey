{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Description": "Module 06 Capstone: High-Availability Web Application with ALB and ASG",
    "Parameters": {
      "VpcId": {
        "Type": "AWS::EC2::VPC::Id",
        "Description": "Target VPC ID for the infrastructure stack."
      },
      "SubnetOne": {
        "Type": "AWS::EC2::Subnet::Id",
        "Description": "First public subnet for ALB and ASG."
      },
      "SubnetTwo": {
        "Type": "AWS::EC2::Subnet::Id",
        "Description": "Second public subnet for ALB and ASG."
      },
      "ImageId": {
        "Type": "String",
        "Description": "AMI ID for EC2 instances (e.g., Amazon Linux 2023)."
      }
    },
    "Resources": {
      "ALBSecurityGroup": {
        "Type": "AWS::EC2::SecurityGroup",
        "Properties": {
          "GroupDescription": "Security group allowing HTTP web traffic to ALB",
          "VpcId": { "Ref": "VpcId" },
          "SecurityGroupIngress": [
            {
              "IpProtocol": "tcp",
              "FromPort": 80,
              "ToPort": 80,
              "CidrIp": "0.0.0.0/0"
            }
          ]
        }
      },
      "ApplicationLoadBalancer": {
        "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
        "Properties": {
          "Name": "cloud-engineer-capstone-alb",
          "Scheme": "internet-facing",
          "Subnets": [
            { "Ref": "SubnetOne" },
            { "Ref": "SubnetTwo" }
          ],
          "SecurityGroups": [{ "Ref": "ALBSecurityGroup" }]
        }
      },
      "ALBTargetGroup": {
        "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
        "Properties": {
          "Name": "capstone-web-tg",
          "Port": 80,
          "Protocol": "HTTP",
          "VpcId": { "Ref": "VpcId" },
          "HealthCheckProtocol": "HTTP",
          "HealthCheckPath": "/",
          "HealthCheckIntervalSeconds": 30
        }
      },
      "ALBListener": {
        "Type": "AWS::ElasticLoadBalancingV2::Listener",
        "Properties": {
          "LoadBalancerArn": { "Ref": "ApplicationLoadBalancer" },
          "Port": 80,
          "Protocol": "HTTP",
          "DefaultActions": [
            {
              "Type": "forward",
              "TargetGroupArn": { "Ref": "ALBTargetGroup" }
            }
          ]
        }
      },
      "WebLaunchTemplate": {
        "Type": "AWS::EC2::LaunchTemplate",
        "Properties": {
          "LaunchTemplateName": "capstone-web-launch-template",
          "LaunchTemplateData": {
            "ImageId": { "Ref": "ImageId" },
            "InstanceType": "t3.micro",
            "UserData": {
              "Fn::Base64": "#!/bin/bash\nyum update -y\nyum install -y httpd\necho '<h1>Module 06 Capstone: High-Availability Web Server</h1>' > /var/www/html/index.html\nsystemctl start httpd\nsystemctl enable httpd"
            }
          }
        }
      },
      "WebServerASG": {
        "Type": "AWS::AutoScaling::AutoScalingGroup",
        "Properties": {
          "AutoScalingGroupName": "capstone-web-asg",
          "VPCZoneIdentifier": [
            { "Ref": "SubnetOne" },
            { "Ref": "SubnetTwo" }
          ],
          "LaunchTemplate": {
            "LaunchTemplateId": { "Ref": "WebLaunchTemplate" },
            "Version": { "Fn::GetAtt": ["WebLaunchTemplate", "LatestVersionNumber"] }
          },
          "MinSize": "1",
          "MaxSize": "3",
          "DesiredCapacity": "2",
          "TargetGroupARNs": [
            { "Ref": "ALBTargetGroup" }
          ],
          "HealthCheckType": "ELB",
          "HealthCheckGracePeriod": 300
        }
      }
    },
    "Outputs": {
      "LoadBalancerDNSName": {
        "Description": "Public DNS endpoint for the Capstone Web Architecture",
        "Value": { "Fn::GetAtt": ["ApplicationLoadBalancer", "DNSName"] }
      }
    }
  }