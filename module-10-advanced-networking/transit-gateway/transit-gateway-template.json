{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Description": "Advanced Networking: AWS Transit Gateway Hub-and-Spoke Architecture",
    "Resources": {
      "TransitGateway": {
        "Type": "AWS::EC2::TransitGateway",
        "Properties": {
          "Description": "Central hub Transit Gateway for enterprise multi-VPC routing",
          "AmazonSideAsn": 64512,
          "AutoAcceptSharedAttachments": "enable",
          "DefaultRouteTableAssociation": "enable",
          "DefaultRouteTablePropagation": "enable",
          "Tags": [
            {
              "Key": "Name",
              "Value": "enterprise-transit-gateway-hub"
            }
          ]
        }
      },
      "SpokeVpcA": {
        "Type": "AWS::EC2::VPC",
        "Properties": {
          "CidrBlock": "10.100.0.0/16",
          "EnableDnsHostnames": true,
          "EnableDnsSupport": true,
          "Tags": [
            {
              "Key": "Name",
              "Value": "vpc-spoke-alpha"
            }
          ]
        }
      },
      "SpokeVpcB": {
        "Type": "AWS::EC2::VPC",
        "Properties": {
          "CidrBlock": "10.200.0.0/16",
          "EnableDnsHostnames": true,
          "EnableDnsSupport": true,
          "Tags": [
            {
              "Key": "Name",
              "Value": "vpc-spoke-beta"
            }
          ]
        }
      },
      "SpokeSubnetA": {
        "Type": "AWS::EC2::Subnet",
        "Properties": {
          "VpcId": { "Ref": "SpokeVpcA" },
          "CidrBlock": "10.100.1.0/24",
          "Tags": [
            {
              "Key": "Name",
              "Value": "subnet-spoke-alpha-priv"
            }
          ]
        }
      },
      "SpokeSubnetB": {
        "Type": "AWS::EC2::Subnet",
        "Properties": {
          "VpcId": { "Ref": "SpokeVpcB" },
          "CidrBlock": "10.200.1.0/24",
          "Tags": [
            {
              "Key": "Name",
              "Value": "subnet-spoke-beta-priv"
            }
          ]
        }
      },
      "TgwAttachmentA": {
        "Type": "AWS::EC2::TransitGatewayAttachment",
        "Properties": {
          "TransitGatewayId": { "Ref": "TransitGateway" },
          "VpcId": { "Ref": "SpokeVpcA" },
          "SubnetIds": [ { "Ref": "SpokeSubnetA" } ],
          "Tags": [
            {
              "Key": "Name",
              "Value": "tgw-attachment-spoke-a"
            }
          ]
        }
      },
      "TgwAttachmentB": {
        "Type": "AWS::EC2::TransitGatewayAttachment",
        "Properties": {
          "TransitGatewayId": { "Ref": "TransitGateway" },
          "VpcId": { "Ref": "SpokeVpcB" },
          "SubnetIds": [ { "Ref": "SpokeSubnetB" } ],
          "Tags": [
            {
              "Key": "Name",
              "Value": "tgw-attachment-spoke-b"
            }
          ]
        }
      }
    },
    "Outputs": {
      "TransitGatewayId": {
        "Description": "The ID of the central AWS Transit Gateway hub",
        "Value": { "Ref": "TransitGateway" }
      }
    }
  }