{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Description": "Module 09 Capstone: End-to-End Enterprise Security, Governance, and Auditing Stack",
    "Parameters": {
      "DBUsername": {
        "Type": "String",
        "Description": "Master username for the secure database secret."
      },
      "DBPassword": {
        "Type": "String",
        "Description": "Master password for the secure database secret.",
        "NoEcho": true
      }
    },
    "Resources": {
      "EnterpriseKMSKey": {
        "Type": "AWS::KMS::Key",
        "Properties": {
          "Description": "Enterprise master encryption key for workloads and secrets",
          "EnableKeyRotation": true,
          "KeyPolicy": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Sid": "EnableRootAccountAdministration",
                "Effect": "Allow",
                "Principal": {
                  "AWS": { "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:root" }
                },
                "Action": "kms:*",
                "Resource": "*"
              }
            ]
          }
        }
      },
      "EnterpriseKMSAlias": {
        "Type": "AWS::KMS::Alias",
        "Properties": {
          "AliasName": "alias/enterprise-capstone-key",
          "TargetKeyId": { "Ref": "EnterpriseKMSKey" }
        }
      },
      "EnterprisePermissionBoundary": {
        "Type": "AWS::IAM::ManagedPolicy",
        "Properties": {
          "Description": "Maximum permissions boundary for enterprise governance",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": [
                  "s3:GetObject",
                  "s3:PutObject",
                  "s3:ListBucket",
                  "secretsmanager:GetSecretValue",
                  "kms:Decrypt",
                  "kms:DescribeKey"
                ],
                "Resource": "*"
              }
            ]
          }
        }
      },
      "EnterpriseBoundedRole": {
        "Type": "AWS::IAM::Role",
        "Properties": {
          "RoleName": "enterprise-bounded-execution-role",
          "AssumeRolePolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Principal": {
                  "Service": [ "ec2.amazonaws.com" ]
                },
                "Action": [ "sts:AssumeRole" ]
              }
            ]
          },
          "PermissionsBoundary": { "Ref": "EnterprisePermissionBoundary" },
          "Policies": [
            {
              "PolicyName": "WorkloadOperationPolicy",
              "PolicyDocument": {
                "Version": "2012-10-17",
                "Statement": [
                  {
                    "Effect": "Allow",
                    "Action": [
                      "s3:GetObject",
                      "s3:PutObject",
                      "s3:ListBucket"
                    ],
                    "Resource": "*"
                  }
                ]
              }
            }
          ]
        }
      },
      "EnterpriseSecret": {
        "Type": "AWS::SecretsManager::Secret",
        "Properties": {
          "Name": "enterprise/production/db-credentials",
          "Description": "Encrypted production database credentials secured with enterprise KMS key",
          "KmsKeyId": { "Ref": "EnterpriseKMSKey" },
          "SecretString": {
            "Fn::Sub": "{\"username\":\"${DBUsername}\",\"password\":\"${DBPassword}\"}"
          }
        }
      },
      "AuditLogBucket": {
        "Type": "AWS::S3::Bucket",
        "Properties": {
          "BucketName": { "Fn::Sub": "enterprise-audit-logs-${AWS::AccountId}-af-south-1" },
          "PublicAccessBlockConfiguration": {
            "BlockPublicAcls": true,
            "BlockPublicPolicy": true,
            "IgnorePublicAcls": true,
            "RestrictPublicBuckets": true
          },
          "OwnershipControls": {
            "Rules": [
              {
                "ObjectOwnership": "BucketOwnerEnforced"
              }
            ]
          }
        }
      },
      "AuditLogBucketPolicy": {
        "Type": "AWS::S3::BucketPolicy",
        "Properties": {
          "Bucket": { "Ref": "AuditLogBucket" },
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Sid": "AWSCloudTrailAclCheck",
                "Effect": "Allow",
                "Principal": { "Service": "cloudtrail.amazonaws.com" },
                "Action": "s3:GetBucketAcl",
                "Resource": { "Fn::Sub": "arn:aws:s3:::${AuditLogBucket}" }
              },
              {
                "Sid": "AWSCloudTrailWrite",
                "Effect": "Allow",
                "Principal": { "Service": "cloudtrail.amazonaws.com" },
                "Action": "s3:PutObject",
                "Resource": { "Fn::Sub": "arn:aws:s3:::${AuditLogBucket}/AWSLogs/${AWS::AccountId}/*" },
                "Condition": {
                  "StringEquals": {
                    "s3:x-amz-acl": "bucket-owner-full-control"
                  }
                }
              }
            ]
          }
        }
      },
      "EnterpriseCloudTrail": {
        "Type": "AWS::CloudTrail::Trail",
        "DependsOn": ["AuditLogBucketPolicy"],
        "Properties": {
          "TrailName": "enterprise-core-audit-trail",
          "S3BucketName": { "Ref": "AuditLogBucket" },
          "IsLogging": true,
          "IsMultiRegionTrail": true,
          "IncludeGlobalServiceEvents": true,
          "EnableLogFileValidation": true
        }
      }
    },
    "Outputs": {
      "KMSKeyArn": {
        "Description": "Enterprise KMS Key ARN",
        "Value": { "Fn::GetAtt": ["EnterpriseKMSKey", "Arn"] }
      },
      "BoundedRoleArn": {
        "Description": "Bounded IAM Execution Role ARN",
        "Value": { "Fn::GetAtt": ["EnterpriseBoundedRole", "Arn"] }
      },
      "SecretArn": {
        "Description": "Secrets Manager Secret ARN",
        "Value": { "Ref": "EnterpriseSecret" }
      },
      "CloudTrailArn": {
        "Description": "Enterprise CloudTrail Audit Trail ARN",
        "Value": { "Fn::GetAtt": ["EnterpriseCloudTrail", "Arn"] }
      }
    }
  }