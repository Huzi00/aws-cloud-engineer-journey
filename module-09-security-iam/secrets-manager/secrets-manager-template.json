{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Description": "Secure AWS Secrets Manager Secret for Database Credentials",
    "Parameters": {
      "DBUsername": {
        "Type": "String",
        "Description": "Master username for the database."
      },
      "DBPassword": {
        "Type": "String",
        "Description": "Master password for the database.",
        "NoEcho": true
      },
      "KMSKeyId": {
        "Type": "String",
        "Description": "KMS Key ID or ARN used to encrypt the secret."
      }
    },
    "Resources": {
      "DatabaseSecret": {
        "Type": "AWS::SecretsManager::Secret",
        "Properties": {
          "Name": "cloud-engineer/database/credentials",
          "Description": "Encrypted production database credentials managed by Secrets Manager",
          "KmsKeyId": { "Ref": "KMSKeyId" },
          "SecretString": {
            "Fn::Sub": "{\"username\":\"${DBUsername}\",\"password\":\"${DBPassword}\"}"
          },
          "Tags": [
            {
              "Key": "Environment",
              "Value": "Production"
            }
          ]
        }
      }
    },
    "Outputs": {
      "SecretArn": {
        "Description": "The Amazon Resource Name (ARN) of the stored secret",
        "Value": { "Ref": "DatabaseSecret" }
      }
    }
  }