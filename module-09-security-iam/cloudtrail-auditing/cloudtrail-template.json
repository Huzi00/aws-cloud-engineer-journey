{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Description": "AWS CloudTrail Auditing and Compliance Trail with S3 Storage",
    "Resources": {
      "CloudTrailBucket": {
        "Type": "AWS::S3::Bucket",
        "Properties": {
          "BucketName": "cloud-engineer-audit-logs-bucket-af-south-1",
          "PublicAccessBlockConfiguration": {
            "BlockPublicAcls": true,
            "BlockPublicPolicy": true,
            "IgnorePublicAcls": true,
            "RestrictPublicBuckets": true
          },
          "OwnershipControls": {
            "Rules": [
              {
                "ObjectOwnership": "BucketOwnerEnforced"
              }
            ]
          }
        }
      },
      "CloudTrailBucketPolicy": {
        "Type": "AWS::S3::BucketPolicy",
        "Properties": {
          "Bucket": { "Ref": "CloudTrailBucket" },
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Sid": "AWSCloudTrailAclCheck",
                "Effect": "Allow",
                "Principal": {
                  "Service": "cloudtrail.amazonaws.com"
                },
                "Action": "s3:GetBucketAcl",
                "Resource": { "Fn::Sub": "arn:aws:s3:::${CloudTrailBucket}" }
              },
              {
                "Sid": "AWSCloudTrailWrite",
                "Effect": "Allow",
                "Principal": {
                  "Service": "cloudtrail.amazonaws.com"
                },
                "Action": "s3:PutObject",
                "Resource": { "Fn::Sub": "arn:aws:s3:::${CloudTrailBucket}/AWSLogs/${AWS::AccountId}/*" },
                "Condition": {
                  "StringEquals": {
                    "s3:x-amz-acl": "bucket-owner-full-control"
                  }
                }
              }
            ]
          }
        }
      },
      "MainAuditTrail": {
        "Type": "AWS::CloudTrail::Trail",
        "DependsOn": ["CloudTrailBucketPolicy"],
        "Properties": {
          "TrailName": "cloud-engineer-core-audit-trail",
          "S3BucketName": { "Ref": "CloudTrailBucket" },
          "IsLogging": true,
          "IsMultiRegionTrail": true,
          "IncludeGlobalServiceEvents": true,
          "EnableLogFileValidation": true
        }
      }
    },
    "Outputs": {
      "TrailArn": {
        "Description": "ARN of the provisioned CloudTrail auditing trail",
        "Value": { "Fn::GetAtt": ["MainAuditTrail", "Arn"] }
      },
      "AuditBucketName": {
        "Description": "Name of the S3 bucket storing immutable audit logs",
        "Value": { "Ref": "CloudTrailBucket" }
      }
    }
  }